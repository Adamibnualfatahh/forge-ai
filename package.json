    "browser-image-compression": "^2.0.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.1",
    "ioredis": "^5.6.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^1.4.5-lts.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "vite": "^6.2.3",
    "web-push": "^3.6.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
